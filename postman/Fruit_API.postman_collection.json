            "id": "9597519c-c48b-4f05-9fe4-134f74be38be",
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const all = JSON.parse(pm.collectionVariables.get('fruits') || '[]');",
              "pm.test('Correct response', () => {",
              "  pm.expect(body).to.be.an('array');",
              "  pm.collectionVariables.set('fruits', JSON.stringify(body));",
              "});",
              "pm.test('Fruit objects contain expected fields', () => {",
              "  body.forEach(f => { pm.expect(f.name).to.be.a('string'); pm.expect(f.nutritions.calories).to.be.a('number'); });",
              "});"
            ],
